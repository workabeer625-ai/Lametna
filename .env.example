# ============================================================
#  لمّتنا / Lametna — متغيرات البيئة (Environment variables)
# ============================================================
# هذه القيم عامة (Public) فقط. ممنوع منعًا باتًا وضع service_role
# أو أي مفتاح سري داخل تطبيق Flutter.
#
# Only PUBLIC values belong here. NEVER put the Supabase
# service_role key (or any secret) inside the Flutter app.
# ------------------------------------------------------------

# رابط مشروع Supabase / Supabase project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# المفتاح العام (anon / publishable) — آمن للتضمين في العميل
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# بيئة التشغيل: dev | staging | prod
APP_ENV=dev

# ------------------------------------------------------------
# لوحة الإدارة فقط (admin/) — تُضبط في Vercel/Netlify، لا في الهاتف
# Admin dashboard only — set in Vercel/Netlify env, not in the app
# ------------------------------------------------------------
# ADMIN_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# ADMIN_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# ------------------------------------------------------------
# أسرار تُضبط داخل Supabase Dashboard فقط (Edge Function secrets)
# Secrets configured ONLY in the Supabase dashboard:
#   SUPABASE_SERVICE_ROLE_KEY   (auto-injected in Edge Functions)
#   CLEANUP_CRON_SECRET         (shared secret for the cleanup job)
# ------------------------------------------------------------
